# ── Public (safe to expose to browser) ───────────────────────────────────────

# Backend API base URL (no trailing slash)
# Local development: http://localhost:5000/api/v1
# Production:        https://logiflow-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Application URL — used for absolute links
# Local: http://localhost:3000  |  Production: https://yourapp.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
# The frontend does NOT need GOOGLE_CLIENT_ID or GOOGLE_CLIENT_SECRET.
# Google OAuth is handled entirely server-side via Passport.js on the backend.
#
# Required backend env vars (set in LogiFlow_Backend/.env):
#   GOOGLE_CLIENT_ID     = from Google Cloud Console → OAuth 2.0 Client ID
#   GOOGLE_CLIENT_SECRET = from Google Cloud Console → OAuth 2.0 Client Secret
#   GOOGLE_CALLBACK_URL  = http://localhost:5000/api/v1/auth/google/callback (local)
#                          https://your-backend.onrender.com/api/v1/auth/google/callback (prod)
#   FRONTEND_URL         = http://localhost:3000 (local)
#                          https://yourapp.vercel.app (prod)
#
# Google Cloud Console setup:
#   1. APIs & Services → Credentials → OAuth 2.0 Client ID
#   2. Authorized JavaScript origins:
#        http://localhost:3000          (local frontend)
#        https://yourapp.vercel.app     (production frontend)
#   3. Authorized redirect URIs:
#        http://localhost:5000/api/v1/auth/google/callback   (local backend)
#        https://your-backend.onrender.com/api/v1/auth/google/callback  (prod backend)
#
# No frontend-specific Google env vars needed — this comment block is documentation only.

