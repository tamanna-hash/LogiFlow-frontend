# ── Public (safe to expose to browser) ───────────────────────────────────────
# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://logiflow-backend.onrender.com/api/v1

# Application URL — used for OAuth redirect URLs and absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server-only variables (never use NEXT_PUBLIC_ for these) ─────────────────
# These belong on the server only. Do NOT expose them via NEXT_PUBLIC_.
# See docs/DEPLOYMENT_CHECKLIST.md for production setup.

# Demo account credentials (dedicated demo-only accounts — NOT production)
# These must be safe for semi-public exposure (dedicated demo DB / sandboxed accounts)
# NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=demo_customer@logiflow.example
# NEXT_PUBLIC_DEMO_CUSTOMER_PASSWORD=demo_password_here
# (Uncomment and populate only if dedicated demo accounts exist on the backend)
